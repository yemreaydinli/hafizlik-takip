From eeb676a7635a304887f87c8fcb15f5189c01bdef Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 1 Oct 2026 08:20:55 +0000
Subject: [PATCH] Gunluk uyarilar icin GitHub Actions zamanlanmis gorevi

---
 .github/workflows/alerts.yml | 38 ++++++++++++++++++++++++++++++++++++
 README.md                    |  5 ++++-
 2 files changed, 42 insertions(+), 1 deletion(-)
 create mode 100644 .github/workflows/alerts.yml

diff --git a/.github/workflows/alerts.yml b/.github/workflows/alerts.yml
new file mode 100644
index 0000000..ef0004b
--- /dev/null
+++ b/.github/workflows/alerts.yml
@@ -0,0 +1,38 @@
+name: Günlük uyarılar
+
+# Her gün 19:00 UTC (Türkiye saatiyle 22:00) akıllı uyarıları üretir.
+# Render'da ücretli Cron Job açmak yerine GitHub Actions kullanılır.
+# Gerekli secret: DATABASE_URL (Repo → Settings → Secrets and variables → Actions)
+on:
+  schedule:
+    - cron: "0 19 * * *"
+  workflow_dispatch:  # Actions sekmesinden elle çalıştırmak için
+
+jobs:
+  generate-alerts:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+
+      - name: Bağımlılıkları kur
+        run: pip install -r requirements.txt
+
+      - name: Uyarıları üret
+        env:
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+          DJANGO_DEBUG: "False"
+          # Komut oturum/çerez kullanmaz; yalnızca ayarların yüklenmesi için gereklidir.
+          DJANGO_SECRET_KEY: not-used-by-this-command-0123456789abcdefghijklmnopqrstuvwxyz
+          DJANGO_ALLOWED_HOSTS: localhost
+        run: |
+          if [ -z "$DATABASE_URL" ]; then
+            echo "DATABASE_URL secret tanımlı değil; Repo Settings → Secrets → Actions bölümünden ekleyin."
+            exit 1
+          fi
+          python manage.py generate_alerts
diff --git a/README.md b/README.md
index a2a00ae..5350946 100644
--- a/README.md
+++ b/README.md
@@ -185,7 +185,10 @@ Sistem responsive olduğu için ek bir mobil uygulamaya gerek yoktur:
 ### Adım 5 — Günlük uyarı üretimi için zamanlanmış görev (opsiyonel ama önerilir)
 
 `generate_alerts` komutunun her gün otomatik çalışması için:
-- **Render:** "Cron Jobs" özelliğini kullanarak günde bir kez `python manage.py generate_alerts` komutunu çalıştırın (ücretsiz katmanda sınırlı sayıda cron job desteklenir).
+- **GitHub Actions (ücretsiz, önerilen):** `.github/workflows/alerts.yml` her gün 19:00 UTC'de komutu çalıştırır.
+  Repo → Settings → Secrets and variables → Actions → **New repository secret** ile `DATABASE_URL`
+  (Neon bağlantı adresi) ekleyin. Test için Actions sekmesinden "Günlük uyarılar" → **Run workflow**.
+- **Render:** "Cron Jobs" özelliği de kullanılabilir, ancak Render dokümanlarına göre cron job başına en az 1 USD/ay ücretlidir.
 - **Alternatif:** GitHub Actions ile günlük bir workflow oluşturup Render'daki bir endpoint'i (veya management komutunu SSH/Shell üzerinden) tetikleyebilirsiniz.
 
 > ⚠️ Bu adımın canlı örnekte (`hafizlik-takip-app`) fiilen kurulu olup olmadığı kod deposundan
