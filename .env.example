# Django
# Üretimde ZORUNLU. Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Veritabanı - boş bırakılırsa yerelde SQLite kullanılır.
# Neon.tech veya Supabase üzerinden alacağınız PostgreSQL bağlantı adresini buraya yapıştırın:
# DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani?sslmode=require
DATABASE_URL=

# Yedek bu kadar gün alınmazsa yönetici ekranında kırmızı uyarı çıkar (varsayılan 7)
BACKUP_WARNING_DAYS=7
